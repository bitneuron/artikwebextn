# Copy to .env for local development. Never commit a real .env file.
# In staging/production, these are injected via AWS Secrets Manager / ECS task
# definition environment variables — not from a file on disk.

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=artikAgentFactory
ENVIRONMENT=development                 # development | production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./artik_agent_factory.db   # RDS Postgres URL in staging/prod

# ── LLM / research ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                      # required for the research pipeline to run
WEB_SEARCH_MAX_USES=5
MAX_QUERIES_PER_RUN=4
EXTRACTION_BATCH_SIZE=15

# ── Scheduler / background execution ─────────────────────────────────────
SCHEDULER_ENABLED=true
EXECUTION_BACKEND=inline                # inline (local) | sqs (AWS)

# ── Slack notifications ──────────────────────────────────────────────────
# A direct Incoming Webhook to this app's own dedicated Slack channel (separate from
# the shared #artik-notify channel artikBroker posts to). See notify_client.py.
SLACK_CHANNEL=#artik-agent-notify        # display-only — the webhook is bound to its own channel in Slack
# SLACK_WEBHOOK_URL is NOT read from .env in prod — see SECRETS_BACKEND below.
# Locally, set it directly as an env var to test real delivery:
# SLACK_WEBHOOK_URL=
NOTIFICATIONS_ENABLED=true
NOTIFICATION_TIMEOUT_SECONDS=10.0
NOTIFICATION_RETRY_COUNT=3

# ── Email Scheduler agent (Gmail SMTP) ────────────────────────────────────
# Sends as ONE fixed Gmail account via an App Password (requires 2-Step Verification
# on that account — generate at myaccount.google.com/apppasswords). Not read from
# .env in prod — see SECRETS_BACKEND below. See services/email_client.py.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# ── Secrets backend ───────────────────────────────────────────────────────
SECRETS_BACKEND=env                     # env (local) | aws (Secrets Manager, staging/prod)
SECRETS_PREFIX=artikagentfactory        # secret paths: {prefix}/{NAME} in Secrets Manager

# ── Auth ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=af_session
APP_SECRET=                             # required in production — signs session cookies
INITIAL_ADMIN_EMAIL=                    # bootstrap admin, first boot only (empty users table)
INITIAL_ADMIN_PASSWORD=                 # must satisfy the password policy (12+ chars, etc.)

# ── Public URL (used to build links in Slack messages) ──────────────────────
APP_BASE_URL=                           # e.g. https://agentfactory.example.com
